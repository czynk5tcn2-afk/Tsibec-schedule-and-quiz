/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self'; manifest-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'

/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /
/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8
/icons/*
  Cache-Control: public, max-age=86400
/cf29f11a3793b97f423e85d8e6c41c11.txt
  Cache-Control: no-store
/calendar.ics
  Cache-Control: no-cache
  Content-Type: text/calendar; charset=utf-8

# JS/CSS 不再用 immutable：同名文件改了内容也能被发现（服务器用 ETag 回 304，很省流量）。
/showcase-xk2.js
  Cache-Control: no-cache
/showcase-xk2.css
  Cache-Control: no-cache
/pwa-v4.js
  Cache-Control: no-cache
# 复习资料（r12）：网址带 ?v=版本号，同样不用 immutable
/study
  Cache-Control: no-cache, must-revalidate
/study.html
  Cache-Control: no-cache, must-revalidate
/study.js
  Cache-Control: no-cache
/study.css
  Cache-Control: no-cache
/study-data/*
  Cache-Control: no-cache
  Content-Type: application/json; charset=utf-8
/study-img/*
  Cache-Control: public, max-age=86400
